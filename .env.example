# Local development environment reference.
# Copy to .env for local use. .env is ignored by Git; never commit real credentials.

# Azure Service Bus emulator
# Read by infra/servicebus/compose.yaml through the repository-root .env. Scripts do not read infra/servicebus/.env.
# ACCEPT_EULA must be Y. SQL_PASSWORD must be set and meet SQL Server password complexity rules.
ACCEPT_EULA=Y
SQL_PASSWORD=replace-with-a-local-strong-sql-password
SQL_WAIT_INTERVAL=15
EMULATOR_HTTP_PORT=5300

# Container runtime for the emulator scripts: podman (default) or docker.
# Read from the shell environment (scripts/container-runtime.ps1), not from this file.
# Podman and Docker run inside WSL; CONTAINER_WSL_DISTRO selects the distribution.
# CONTAINER_RUNTIME=podman
# CONTAINER_WSL_DISTRO=Ubuntu

# CommerceApi
DigitalSite__PaymentGateway=Stub
# Use AdyenComponent for local Adyen card-component testing without webhooks.
# DigitalSite__PaymentGateway=AdyenComponent

Adyen__Environment=test
Adyen__MerchantAccount=your-test-merchant-account
Adyen__ApiKey=replace-with-local-adyen-api-key
Adyen__ClientKey=replace-with-adyen-client-key

# Required only for full Adyen payment mode, not AdyenComponent.
# Adyen__HmacKey=replace-with-local-adyen-webhook-hmac-key

# Optional: use APIM instead of a direct Adyen API connection.
# Adyen__CheckoutApiUrl=https://your-apim-host/adyen/checkout/v72
# Adyen__ApimSubscriptionKey=replace-with-local-apim-subscription-key

# Dashboard and local service URLs
DIGITAL_SITE_API_BASE_URL=http://localhost:5200
