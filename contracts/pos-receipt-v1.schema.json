{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://service-bus-poc/schemas/pos-receipt-v1.schema.json",
  "title": "POS Receipt",
  "description": "Canonical JSON representation of a locally simulated point-of-sale receipt, generated by the dashboard's Local Processing tab and persisted as POS_RECEIPT_EVENT / POS_RECEIPT_LINE_ITEM rows in the local SQLite database. This is a UI-local simulation contract, not a message published to the contact.events topic.",
  "type": "object",
  "properties": {
    "receiptBarcode": {
      "type": "string",
      "pattern": "^\\d{12}$",
      "description": "Simulated scannable barcode uniquely identifying the receipt, derived from a monotonically increasing sequence"
    },
    "eventId": { "type": "string", "description": "Unique identifier of the persisted POS_RECEIPT_EVENT row" },
    "storeId": { "type": "string", "description": "Catalog store identifier" },
    "tillId": { "type": "string", "description": "Catalog till (point-of-sale terminal) identifier" },
    "operatorId": { "type": "string", "description": "Catalog operator (cashier) identifier" },
    "transactionDate": { "type": "string", "format": "date-time", "description": "Timestamp the receipt was generated" },
    "customer": { "$ref": "#/definitions/customer" },
    "financials": { "$ref": "#/definitions/financials" },
    "payments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/payment" }
    },
    "lineItems": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/lineItem" }
    }
  },
  "additionalProperties": false,
  "required": [
    "receiptBarcode",
    "eventId",
    "storeId",
    "tillId",
    "operatorId",
    "transactionDate",
    "customer",
    "financials",
    "payments",
    "lineItems"
  ],
  "definitions": {
    "customer": {
      "type": "object",
      "properties": {
        "membershipNumber": { "type": ["string", "null"], "description": "Loyalty membership number, null when the customer has no membership" },
        "membershipLevel": { "type": "string", "enum": ["0", "1", "2", "6", "7", "8"], "description": "Canonical numeric membership level identifier" },
        "customerNumber": { "type": ["string", "null"], "description": "Customer account number, null when the customer has no membership" },
        "vehicleRegistration": { "type": ["string", "null"], "description": "Vehicle registration plate captured for the carwash service" },
        "vehicleVin": { "type": ["string", "null"], "description": "Vehicle identification number, when captured" }
      },
      "additionalProperties": false,
      "required": ["membershipNumber", "membershipLevel", "customerNumber", "vehicleRegistration", "vehicleVin"]
    },
    "financials": {
      "type": "object",
      "properties": {
        "totalExGst": { "type": "number", "description": "Sum of all lineItems[].lineAmount" },
        "totalGst": { "type": "number", "description": "Sum of all lineItems[].gstAmount" },
        "totalIncGst": { "type": "number", "description": "totalExGst + totalGst" },
        "refundFlag": { "type": "string", "enum": ["INVOICE", "CREDIT"], "description": "INVOICE for a positive transaction; CREDIT for a refund" }
      },
      "additionalProperties": false,
      "required": ["totalExGst", "totalGst", "totalIncGst", "refundFlag"]
    },
    "payment": {
      "type": "object",
      "properties": {
        "paymentType": { "type": "string", "description": "Catalog payment method identifier" },
        "amount": { "type": "number", "description": "Amount tendered by this payment" },
        "eftposTerminalId": { "type": ["string", "null"], "description": "EFTPOS terminal identifier, null for non-card payment types" },
        "eftposRefNo": { "type": ["string", "null"], "description": "EFTPOS transaction reference number, null for non-card payment types" },
        "paymentGl": { "type": "string", "description": "General ledger code the payment posts to" }
      },
      "additionalProperties": false,
      "required": ["paymentType", "amount", "eftposTerminalId", "eftposRefNo", "paymentGl"]
    },
    "lineItem": {
      "type": "object",
      "properties": {
        "lineNumber": { "type": "integer", "minimum": 1, "description": "1-based position of the line item on the receipt" },
        "itemCode": { "type": "string", "description": "Catalog product item code" },
        "itemDescription": { "type": "string", "description": "Catalog product description" },
        "quantity": { "type": "integer", "minimum": 1, "description": "Units purchased" },
        "unitPrice": { "type": "number", "minimum": 0, "description": "Catalog unit price at time of generation" },
        "lineAmount": { "type": "number", "description": "(quantity * unitPrice) - discount.discountAmount, excluding GST" },
        "gstAmount": { "type": "number", "minimum": 0, "description": "GST calculated on lineAmount using gstCategory's rate" },
        "gstCategory": { "type": "string", "enum": ["TAXABLE SUPPLY", "FREE"], "description": "Cardzoids GST category applied to this line" },
        "itemParentCategory": { "type": "string", "description": "Top-level catalog category" },
        "itemCategory": { "type": "string", "description": "Catalog category" },
        "itemSubCategory": { "type": "string", "description": "Catalog sub-category" },
        "discount": { "$ref": "#/definitions/discount" },
        "pricingLevel1": { "type": "string", "enum": ["Y", "N"], "description": "Y for membership levels 6, 7, or 8; otherwise N" },
        "dispositionCodes": { "type": "string", "description": "Comma-separated canonical event disposition codes" },
        "membershipProductGlCode": { "type": "string", "description": "General ledger code the product posts to" }
      },
      "additionalProperties": false,
      "required": [
        "lineNumber",
        "itemCode",
        "itemDescription",
        "quantity",
        "unitPrice",
        "lineAmount",
        "gstAmount",
        "gstCategory",
        "itemParentCategory",
        "itemCategory",
        "itemSubCategory",
        "discount",
        "pricingLevel1",
        "dispositionCodes",
        "membershipProductGlCode"
      ]
    },
    "discount": {
      "type": "object",
      "properties": {
        "discountType": { "type": ["string", "null"], "description": "Discount type applied to the line, null when no discount was applied" },
        "discountAmount": { "type": "number", "minimum": 0, "description": "Discount amount subtracted from the line's gross amount" }
      },
      "additionalProperties": false,
      "required": ["discountType", "discountAmount"]
    }
  }
}
