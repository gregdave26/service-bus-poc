# Copy this file to .env in the same folder and fill in your own values.
# .env is gitignored - never commit real values here.

# Must be "Y" to accept the emulator's EULA: https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
ACCEPT_EULA=Y

# SQL Edge admin password backing the emulator's metadata store.
# Must satisfy SQL Server's strong password policy (upper/lower/digit/symbol, 8+ chars).
# Replace this local-development value if required.
SQL_PASSWORD=LocalDev_StrongPassword1!

# Optional: seconds to wait for SQL Edge to become ready before the emulator starts (default 15).
SQL_WAIT_INTERVAL=15

# Optional: port for the emulator's management/health-check HTTP API (default 5300).
EMULATOR_HTTP_PORT=5300

# CommerceApi local environment reference.
# Copy to .env for local use, then replace only the placeholder values.
# .env is ignored by Git. Never commit real Adyen credentials.

# Keep Stub unless valid Adyen test credentials are configured below.
DigitalSite__PaymentGateway=Stub

Adyen__Environment=test
Adyen__MerchantAccount=your-test-merchant-account
Adyen__ApiKey=replace-with-local-adyen-api-key
Adyen__ClientKey=replace-with-adyen-client-key
Adyen__HmacKey=replace-with-local-adyen-hmac-key

# Optional: use APIM instead of a direct Adyen API connection.
# Adyen__CheckoutApiUrl=https://your-apim-host/adyen/checkout/v72
# Adyen__ApimSubscriptionKey=replace-with-local-apim-subscription-key
