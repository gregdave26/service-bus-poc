{
  "UserConfig": {
    "Namespaces": [
      {
        "Name": "sbemulatorns",
        "Queues": [],
        "Topics": [
          {
            "Name": "contact.events",
            "Properties": {
              "DefaultMessageTimeToLive": "PT1H",
              "DuplicateDetectionHistoryTimeWindow": "PT20S",
              "RequiresDuplicateDetection": false
            },
            "Subscriptions": [
              {
                "Name": "digital-channels",
                "Properties": {
                  "DeadLetteringOnMessageExpiration": false,
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT1M",
                  "MaxDeliveryCount": 3,
                  "ForwardDeadLetteredMessagesTo": "",
                  "ForwardTo": "",
                  "RequiresSession": false
                }
              },
              {
                "Name": "insurance",
                "Properties": {
                  "DeadLetteringOnMessageExpiration": false,
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT1M",
                  "MaxDeliveryCount": 3,
                  "ForwardDeadLetteredMessagesTo": "",
                  "ForwardTo": "",
                  "RequiresSession": false
                },
                "Rules": [
                  {
                    "Name": "has-insurance-filter",
                    "Properties": {
                      "FilterType": "Sql",
                      "SqlFilter": {
                        "SqlExpression": "hasInsurance = true"
                        }
                    }
                  }
                ]
              },
              {
                "Name": "parks-resorts",
                "Properties": {
                  "DeadLetteringOnMessageExpiration": false,
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT1M",
                  "MaxDeliveryCount": 3,
                  "ForwardDeadLetteredMessagesTo": "",
                  "ForwardTo": "",
                  "RequiresSession": false
                },
                "Rules": [
                  {
                    "Name": "has-parks-resorts-filter",
                    "Properties": {
                      "FilterType": "Sql",
                      "SqlFilter": {
                        "SqlExpression": "hasParksResorts = true"
                      }
                    }
                  }
                ]
              },
              {
                "Name": "carwash",
                "Properties": {
                  "DeadLetteringOnMessageExpiration": false,
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT1M",
                  "MaxDeliveryCount": 3,
                  "ForwardDeadLetteredMessagesTo": "",
                  "ForwardTo": "",
                  "RequiresSession": false
                },
                "Rules": [
                  {
                    "Name": "has-carwash-product-filter",
                    "Properties": {
                      "FilterType": "Sql",
                      "SqlFilter": {
                        "SqlExpression": "hasCarwashProduct = true"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "Logging": {
      "Type": "File"
    }
  },
  "Dashboard": {
    "SubscriberLabels": {
      "digital-channels": {
        "DisplayName": "Digital Channels",
        "ConnectedLabel": "Connected",
        "OfflineLabel": "Offline",
        "MessagesHandledLabel": "handled"
      },
      "insurance": {
        "DisplayName": "Insurance",
        "ConnectedLabel": "Connected",
        "OfflineLabel": "Offline",
        "MessagesHandledLabel": "handled"
      },
      "parks-resorts": {
        "DisplayName": "Parks & Resorts",
        "ConnectedLabel": "Connected",
        "OfflineLabel": "Offline",
        "MessagesHandledLabel": "handled"
      },
      "carwash": {
        "DisplayName": "Carwash",
        "ConnectedLabel": "Connected",
        "OfflineLabel": "Offline",
        "MessagesHandledLabel": "handled"
      }
    },
    "ProducerLabels": {
      "DisplayName": "Message Publisher",
      "ConnectedLabel": "Ready",
      "OfflineLabel": "Offline",
      "MessagesHandledLabel": "published"
    },
    "MessageTypes": {
      "ContactUpdated": {
        "DisplayName": "Contact updated",
        "Fields": [
          { "Name": "contactId", "Label": "Contact ID", "Type": "text", "Required": true },
          { "Name": "firstName", "Label": "First name", "Type": "text", "Required": true },
          { "Name": "lastName", "Label": "Last name", "Type": "text", "Required": true },
          { "Name": "phone", "Label": "Phone", "Type": "text", "Required": true },
          { "Name": "email", "Label": "Email", "Type": "email", "Required": true },
          { "Name": "hasInsurance", "Label": "Insurance", "Type": "boolean" },
          { "Name": "hasParksResorts", "Label": "Parks & Resorts", "Type": "boolean" },
          { "Name": "hasCarwashProduct", "Label": "Carwash", "Type": "boolean" }
        ]
      },
      "ProductHoldingChange": {
        "DisplayName": "Product holding change",
        "Fields": [
          { "Name": "contactId", "Label": "Contact ID", "Type": "text", "Required": true },
          { "Name": "holdingId", "Label": "Holding ID", "Type": "text", "Required": true },
          { "Name": "productType", "Label": "Product type", "Type": "text", "Options": ["insurance", "parks-resorts", "carwash", "other"], "Required": true },
          { "Name": "action", "Label": "Action", "Type": "text", "Options": ["created", "modified", "removed"], "Required": true }
        ]
      }
    }
  }
}
