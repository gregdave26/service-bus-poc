{
  "UserConfig": {
    "Namespaces": [
      {
        "Name": "sbemulatorns",
        "Queues": [],
        "Topics": [
          {
            "Name": "contact.events",
            "Properties": {
              "DefaultMessageTimeToLive": "PT1H",
              "DuplicateDetectionHistoryTimeWindow": "PT20S",
              "RequiresDuplicateDetection": false
            },
            "Subscriptions": [
              {
                "Name": "digital-channels",
                "Properties": {
                  "DeadLetteringOnMessageExpiration": false,
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT1M",
                  "MaxDeliveryCount": 3,
                  "ForwardDeadLetteredMessagesTo": "",
                  "ForwardTo": "",
                  "RequiresSession": false
                }
              },
              {
                "Name": "insurance",
                "Properties": {
                  "DeadLetteringOnMessageExpiration": false,
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT1M",
                  "MaxDeliveryCount": 3,
                  "ForwardDeadLetteredMessagesTo": "",
                  "ForwardTo": "",
                  "RequiresSession": false
                },
                "Rules": [
                  {
                    "Name": "has-insurance-filter",
                    "Properties": {
                      "FilterType": "Sql",
                      "SqlFilter": {
                        "SqlExpression": "hasInsurance = true"
                        }
                    }
                  }
                ]
              },
              {
                "Name": "parks-resorts",
                "Properties": {
                  "DeadLetteringOnMessageExpiration": false,
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT1M",
                  "MaxDeliveryCount": 3,
                  "ForwardDeadLetteredMessagesTo": "",
                  "ForwardTo": "",
                  "RequiresSession": false
                },
                "Rules": [
                  {
                    "Name": "has-parks-resorts-filter",
                    "Properties": {
                      "FilterType": "Sql",
                      "SqlFilter": {
                        "SqlExpression": "hasParksResorts = true"
                      }
                    }
                  }
                ]
              },
              {
                "Name": "carwash",
                "Properties": {
                  "DeadLetteringOnMessageExpiration": false,
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT1M",
                  "MaxDeliveryCount": 3,
                  "ForwardDeadLetteredMessagesTo": "",
                  "ForwardTo": "",
                  "RequiresSession": false
                },
                "Rules": [
                  {
                    "Name": "has-carwash-product-filter",
                    "Properties": {
                      "FilterType": "Sql",
                      "SqlFilter": {
                        "SqlExpression": "hasCarwashProduct = true"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "Name": "commerce.events",
            "Properties": {
              "DefaultMessageTimeToLive": "PT1H",
              "DuplicateDetectionHistoryTimeWindow": "PT20S",
              "RequiresDuplicateDetection": false
            },
            "Subscriptions": [
              {
                "Name": "cart-processor",
                "Properties": {
                  "DeadLetteringOnMessageExpiration": false,
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT1M",
                  "MaxDeliveryCount": 5,
                  "ForwardDeadLetteredMessagesTo": "",
                  "ForwardTo": "",
                  "RequiresSession": false
                },
                "Rules": [
                  {
                    "Name": "payment-transaction-filter",
                    "Properties": {
                      "FilterType": "Sql",
                      "SqlFilter": {
                        "SqlExpression": "messageType IN ('PaymentTransactionAdded', 'PaymentTransactionStateChanged')"
                      }
                    }
                  }
                ]
              },
              {
                "Name": "fulfilment-d365-stub",
                "Properties": {
                  "DeadLetteringOnMessageExpiration": false,
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT1M",
                  "MaxDeliveryCount": 5,
                  "ForwardDeadLetteredMessagesTo": "",
                  "ForwardTo": "",
                  "RequiresSession": false
                },
                "Rules": [
                  {
                    "Name": "order-created-filter",
                    "Properties": {
                      "FilterType": "Sql",
                      "SqlFilter": {
                        "SqlExpression": "messageType = 'OrderCreated'"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "Logging": {
      "Type": "File"
    }
  },
  "Dashboard": {
    "SubscriberLabels": {
      "digital-channels": {
        "DisplayName": "Digital Channels",
        "ConnectedLabel": "Connected",
        "OfflineLabel": "Offline",
        "MessagesHandledLabel": "handled"
      },
      "insurance": {
        "DisplayName": "Insurance",
        "ConnectedLabel": "Connected",
        "OfflineLabel": "Offline",
        "MessagesHandledLabel": "handled"
      },
      "parks-resorts": {
        "DisplayName": "Parks & Resorts",
        "ConnectedLabel": "Connected",
        "OfflineLabel": "Offline",
        "MessagesHandledLabel": "handled"
      },
      "carwash": {
        "DisplayName": "Carwash",
        "ConnectedLabel": "Connected",
        "OfflineLabel": "Offline",
        "MessagesHandledLabel": "handled"
      }
    },
    "ProducerLabels": {
      "DisplayName": "Message Publisher",
      "ConnectedLabel": "Ready",
      "OfflineLabel": "Offline",
      "MessagesHandledLabel": "published"
    },
    "MessageTypes": {
      "ContactUpdated": {
        "DisplayName": "Contact updated",
        "Schema": "contact-updated-v1.schema.json",
        "FormFields": {
          "contactId": { "Label": "Contact ID", "Order": 1 },
          "firstName": { "Label": "First name", "Order": 2 },
          "lastName": { "Label": "Last name", "Order": 3 },
          "phone": { "Label": "Phone", "Order": 4 },
          "email": { "Label": "Email", "Order": 5 },
          "hasInsurance": { "Label": "Insurance", "Order": 6, "Type": "boolean" },
          "hasParksResorts": { "Label": "Parks & Resorts", "Order": 7, "Type": "boolean" },
          "hasCarwashProduct": { "Label": "Carwash", "Order": 8, "Type": "boolean" }
        }
      },
      "ProductHoldingChange": {
        "DisplayName": "Product holding change",
        "Schema": "product-holding-change-v1.schema.json",
        "FormFields": {
          "contactId": { "Label": "Contact ID", "Order": 1 },
          "holdingId": { "Label": "Holding ID", "Order": 2 },
          "productType": { "Label": "Product type", "Order": 3 },
          "action": { "Label": "Action", "Order": 4 }
        }
      }
    }
  }
}
