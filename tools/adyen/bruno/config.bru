meta {
  name: Payment gateway configuration
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/config
  body: none
  auth: none
}

tests {
  test("payment gateway mode is reported", function() {
    expect(res.status).to.equal(200);
    expect(res.body.gateway).to.be.a("string").and.not.empty;
  });
}
